# Environment configuration for Endangered Species Real-Time Lakehouse

# Database (PostgreSQL)
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=lakehouse123
POSTGRES_DB=iceberg_catalog
POSTGRES_PORT=5432

# MinIO Object Store (S3 Lakehouse Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=species.observations
KAFKA_PARTITIONS=3
KAFKA_RETENTION_MS=604800000

# Trino Serving Engine
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=admin
TRINO_CATALOG=iceberg
TRINO_SCHEMA=wildlife

# Apache Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://lakehouse:lakehouse123@postgres:5432/airflow
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW_PORT=8081

# Apache Superset
SUPERSET_SECRET_KEY=lakehouse_superset_secret_key_change_in_production_123
SUPERSET_PORT=8088

# Phase 1 Dashboard
DASHBOARD_PORT=8050

# Alerting & Observability
SMTP_HOST=mailhog
SMTP_PORT=1025
MAILHOG_UI_PORT=8025
ALERT_EMAIL_TO=admin@lakehouse.local
ALERT_EMAIL_FROM=alerts@lakehouse.local
SLACK_WEBHOOK_URL=

# Health Check Thresholds
FRESHNESS_THRESHOLD_MINUTES=5
DLQ_RATE_THRESHOLD=0.10
KAFKA_LAG_THRESHOLD=500

